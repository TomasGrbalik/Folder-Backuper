<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Label="Product identity">
    <VersionPrefix>1.1.1</VersionPrefix>
    <!-- Every build that the release workflow did not produce carries this suffix, so a
         development binary can never be mistaken for a release. Only build/Set-ProductVersion.ps1
         writes these two elements, and the release workflow clears the suffix for one commit. -->
    <VersionSuffix></VersionSuffix>
    <!-- Inno Setup reads the Win32 version resource, so FileVersion must be a plain numeric
         version, unaffected by the suffix. The suffix reaches the installer filename and the web
         interface through InformationalVersion, which the SDK also stamps with the commit hash. -->
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <Product>Folder Backuper</Product>
    <Company>Folder Backuper</Company>
    <Copyright>Copyright (c) Folder Backuper contributors</Copyright>
    <!-- English is the neutral resource language and Slovak is the one satellite the product ships.
         Widening this list ships satellite assemblies nobody asked for; narrowing it silently strips
         the Slovak interface from publish output, which docs/release-checklist.md asserts against. -->
    <SatelliteResourceLanguages>en;sk</SatelliteResourceLanguages>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
