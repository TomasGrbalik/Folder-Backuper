@page "/destinations"
@inject DestinationService DestinationService
@inject IDialogService DialogService

<PageTitle>Destinations | Folder Backuper</PageTitle>

@if (operationMessage is not null)
{
    <MudAlert Severity="@(operationError ? Severity.Error : Severity.Success)" CloseIcon="@Icons.Material.Filled.Close" ShowCloseIcon="true" CloseIconClicked="() => operationMessage = null">@operationMessage</MudAlert>
}

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h1">Destinations</MudText>
        <MudText Class="page-lead">Verified local and network storage roots for future backup jobs.</MudText>
    </div>
    <MudStack Row="true">
        <MudButton Variant="@(showArchived ? Variant.Outlined : Variant.Text)" OnClick="ToggleArchivedAsync">@(showArchived ? "Show active" : "Show archived")</MudButton>
        @if (!showArchived) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">Add destination</MudButton> }
    </MudStack>
</div>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (destinations.Count == 0)
{
    <MudPaper Class="destination-empty" Elevation="0">
        <MudIcon Icon="@Icons.Material.Outlined.Storage" Size="Size.Large" />
        <MudText Typo="Typo.h5">No storage roots configured</MudText>
        <MudText>Add a local folder or an SMB share, then verify service access.</MudText>
    </MudPaper>
}
else
{
    <div class="destination-grid">
        @foreach (var destination in destinations)
        {
            <MudPaper Class="destination-card" Elevation="0">
                <div class="destination-card-head">
                    <MudIcon Icon="@(destination.Type == DestinationType.Local ? Icons.Material.Outlined.Storage : Icons.Material.Outlined.Dns)" />
                    <div>
                        <MudText Typo="Typo.h5">@destination.Name</MudText>
                        <MudText Typo="Typo.caption">@(destination.Type == DestinationType.Local ? "LOCAL STORAGE" : "SMB STORAGE")</MudText>
                    </div>
                    <MudChip T="string" Size="Size.Small" Color="@VerificationColor(destination.VerificationResult)">@destination.VerificationResult</MudChip>
                </div>
                <MudText Class="destination-path">@destination.RootPath</MudText>
                @if (destination.SmbUsername is not null)
                {
                    <MudText Typo="Typo.body2">Account: @destination.SmbUsername</MudText>
                }
                <MudText Typo="Typo.body2">Available: @(destination.AvailableBytes is long bytes ? FormatBytes(bytes) : "Not reported")</MudText>
                <MudText Typo="Typo.body2">@LastTestText(destination)</MudText>
                <div class="destination-actions">
                    @if (destination.Lifecycle == DestinationLifecycle.Archived)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => RestoreAsync(destination))">Restore</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditAsync(destination))">Edit</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.FactCheck" OnClick="@(() => TestAsync(destination))">Test access</MudButton>
                        <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="@(() => ArchiveAsync(destination))">Archive</MudButton>
                    }
                </div>
            </MudPaper>
        }
    </div>
}

@code {
    private IReadOnlyList<DestinationSummary> destinations = [];
    private bool loading = true;
    private bool showArchived;
    private string? operationMessage;
    private bool operationError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        loading = true;
        var all = await DestinationService.ListAsync(showArchived);
        destinations = showArchived ? all.Where(x => x.Lifecycle == DestinationLifecycle.Archived).ToArray() : all;
        loading = false;
    }
    private async Task ToggleArchivedAsync() { showArchived = !showArchived; await ReloadAsync(); }
    private async Task ArchiveAsync(DestinationSummary destination)
    {
        if (await DialogService.ShowMessageBoxAsync("Archive destination?", $"Archive {destination.Name}? It can be restored later.", yesText: "Archive", cancelText: "Cancel") != true) return;
        await ApplyAsync(await DestinationService.ArchiveAsync(destination.Id));
    }
    private async Task RestoreAsync(DestinationSummary destination)
    {
        if (await DialogService.ShowMessageBoxAsync("Restore destination?", $"Restore {destination.Name}? It will need access verification.", yesText: "Restore", cancelText: "Cancel") != true) return;
        await ApplyAsync(await DestinationService.RestoreAsync(destination.Id));
    }
    private async Task ApplyAsync(DestinationOperationResult result)
    {
        operationMessage = result.Message;
        operationError = !result.Succeeded;
        await ReloadAsync();
    }
    private async Task CreateAsync()
    {
        var dialog = await DialogService.ShowAsync<DestinationFormDialog>("Add destination", options: DialogOptions());
        if ((await dialog.Result)?.Canceled == false) await ReloadAsync();
    }
    private async Task EditAsync(DestinationSummary destination)
    {
        var parameters = new DialogParameters { [nameof(DestinationFormDialog.Destination)] = destination };
        var dialog = await DialogService.ShowAsync<DestinationFormDialog>("Edit destination", parameters, DialogOptions());
        if ((await dialog.Result)?.Canceled == false) await ReloadAsync();
    }
    private async Task TestAsync(DestinationSummary destination)
    {
        var parameters = new DialogParameters { [nameof(DestinationTestDialog.Destination)] = destination };
        var dialog = await DialogService.ShowAsync<DestinationTestDialog>("Test destination access", parameters, DialogOptions());
        await dialog.Result;
        await ReloadAsync();
    }
    private static DialogOptions DialogOptions() => new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private static Color VerificationColor(DestinationVerificationResult result) => result switch
    {
        DestinationVerificationResult.Succeeded => Color.Success,
        DestinationVerificationResult.Failed => Color.Error,
        _ => Color.Default
    };
    private static string FormatBytes(long value)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var amount = (double)value; var unit = 0;
        while (amount >= 1024 && unit < units.Length - 1) { amount /= 1024; unit++; }
        return $"{amount:0.#} {units[unit]}";
    }
    private static string LastTestText(DestinationSummary destination) => destination.LastAccessedAtUtc is { } testedAt
        ? $"Last test: {destination.LastAccessResult} on {testedAt.ToLocalTime():g}"
        : "Last test: Not attempted";
}
