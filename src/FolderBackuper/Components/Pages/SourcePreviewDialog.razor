@using System.Globalization
@inject SourcePreview SourcePreview
@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true">@UiStrings.SourcePreviewNotice</MudAlert>
        <MudText Class="source-preview-path">@Path</MudText>
        @if (snapshot is null) { <MudProgressLinear Indeterminate="true" /> }
        else
        {
            <div class="preview-metrics">
                <span><strong>@Count(snapshot.FileCount)</strong> @Plural.Choose(snapshot.FileCount, UiStrings.CountFiles_One, UiStrings.CountFiles_Few, UiStrings.CountFiles_Many)</span>
                <span><strong>@Count(snapshot.FolderCount)</strong> @Plural.Choose(snapshot.FolderCount, UiStrings.CountFolders_One, UiStrings.CountFolders_Few, UiStrings.CountFolders_Many)</span>
                <span><strong>@DisplayFormat.Bytes(snapshot.TotalBytes)</strong> @UiStrings.SourcePreviewSourceData</span>
                <span><strong>@Count(snapshot.InaccessibleEntryCount)</strong> @Plural.Choose(snapshot.InaccessibleEntryCount, UiStrings.CountInaccessible_One, UiStrings.CountInaccessible_Few, UiStrings.CountInaccessible_Many)</span>
                <span><strong>@Count(snapshot.SkippedReparsePointCount)</strong> @Plural.Choose(snapshot.SkippedReparsePointCount, UiStrings.CountReparsePointsSkipped_One, UiStrings.CountReparsePointsSkipped_Few, UiStrings.CountReparsePointsSkipped_Many)</span>
            </div>
            @if (!snapshot.IsComplete) { <MudProgressLinear Indeterminate="true" Class="mt-3" /> }
            @foreach (var issue in snapshot.InaccessibleEntrySamples)
            { <MudText Typo="Typo.caption" Color="Color.Warning">@issue.Path: @issue.Problem</MudText> }
        }
        @if (error is not null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
    </DialogContent>
    <DialogActions>
        @if (snapshot?.IsComplete != true && error is null) { <MudButton OnClick="CancelScan">@UiStrings.SourcePreviewCancelScan</MudButton> }
        <MudButton Color="Color.Primary" Disabled="@(snapshot is null)" OnClick="Close">@UiStrings.ActionClose</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    private readonly CancellationTokenSource cancellation = new();
    private SourcePreviewSnapshot? snapshot;
    private string? error;
    private bool disposed;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await foreach (var item in SourcePreview.InspectAsync(Path, cancellationToken: cancellation.Token))
            {
                if (disposed) return;
                snapshot = item;
                await InvokeAsync(() => { if (!disposed) StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException)
        { if (!disposed) error = exception.Message; }
    }
    // The count and its noun are separated so that the noun can take a Slovak plural form, which
    // an English "(s)" suffix cannot express.
    private static string Count(long value) => value.ToString("N0", CultureInfo.CurrentCulture);

    private void CancelScan() { if (!disposed) cancellation.Cancel(); }
    private void Close()
    {
        CancelScan();
        Dialog.Close(snapshot is null ? DialogResult.Ok(true) : DialogResult.Ok(snapshot));
    }
    public void Dispose()
    {
        if (disposed) return;
        disposed = true;
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
