@using System.Globalization
@page "/"
@implements IDisposable
@inject DashboardQueryService DashboardQueries
@inject RunActivitySignal RunActivity
@inject DestinationService DestinationService
@inject BackupExecutionService BackupExecution
@inject BackupRetentionService Retention
@inject NavigationManager Navigation

<PageTitle>@string.Format(CultureInfo.CurrentCulture, UiStrings.PageTitleFormat, UiStrings.NavDashboard)</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h1">@UiStrings.DashboardTitle</MudText>
        <MudText Class="page-lead">@UiStrings.DashboardLead</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync">@UiStrings.ActionRefresh</MudButton>
</div>

@if (operationMessage is not null)
{
    <MudAlert Severity="@(operationError ? Severity.Error : Severity.Success)" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => operationMessage = null">@operationMessage</MudAlert>
}

@if (loading || view is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (view.FailureCount > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-2">@Plural.Format(view.FailureCount, UiStrings.DashboardAlertFailed_One, UiStrings.DashboardAlertFailed_Few, UiStrings.DashboardAlertFailed_Many)</MudAlert>
    }
    @if (view.WarningCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">@Plural.Format(view.WarningCount, UiStrings.DashboardAlertWarnings_One, UiStrings.DashboardAlertWarnings_Few, UiStrings.DashboardAlertWarnings_Many)</MudAlert>
    }
    @if (view.NotificationFailureCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">@Plural.Format(view.NotificationFailureCount, UiStrings.DashboardAlertNotification_One, UiStrings.DashboardAlertNotification_Few, UiStrings.DashboardAlertNotification_Many)</MudAlert>
    }

    <section class="dashboard-section">
        <MudText Typo="Typo.h5">@UiStrings.DashboardSectionActive</MudText>
        @if (view.ActiveRun is { } active)
        {
            <ActiveRunPanel Run="active" OnChanged="ReloadAsync" />
        }
        else
        {
            <MudPaper Class="dashboard-idle" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" />
                <MudText>@UiStrings.DashboardIdle</MudText>
            </MudPaper>
        }
    </section>

    @if (view.Queue.Count > 0)
    {
        <section class="dashboard-section">
            <MudText Typo="Typo.h5">@string.Format(CultureInfo.CurrentCulture, UiStrings.DashboardSectionQueued, view.Queue.Count)</MudText>
            <MudList T="string" Dense="true" Class="queue-list">
                @foreach (var queued in view.Queue)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Outlined.Schedule">
                        <strong>@queued.JobName</strong> — @string.Format(CultureInfo.CurrentCulture, UiStrings.DashboardQueueEntry, MonitoringDisplay.TriggerLabel(queued.Trigger), DisplayFormat.LocalDateTime(queued.DueAtUtc))
                    </MudListItem>
                }
            </MudList>
        </section>
    }

    <section class="dashboard-section">
        <MudText Typo="Typo.h5">@UiStrings.DashboardSectionJobs</MudText>
        @if (view.Jobs.Count == 0)
        {
            <MudPaper Class="destination-empty" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.FolderCopy" Size="Size.Large" />
                <MudText Typo="Typo.h5">@UiStrings.DashboardNoJobsHeading</MudText>
                <MudText>@UiStrings.DashboardNoJobsBody</MudText>
            </MudPaper>
        }
        else
        {
            <div class="dashboard-grid">
                @foreach (var job in view.Jobs)
                {
                    <MudPaper Class="dashboard-card" Elevation="0">
                        <div class="dashboard-card-head">
                            <MudText Typo="Typo.h6">@job.JobName</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.OutcomeColor(job.LastOutcome)">
                                @(job.LastOutcome is null ? UiStrings.DashboardNoRunsYet : MonitoringDisplay.OutcomeLabel(job.LastOutcome))
                            </MudChip>
                        </div>
                        <dl class="dashboard-facts">
                            <div><dt>@UiStrings.DashboardLastRun</dt><dd>@DisplayFormat.LocalDateTime(job.LastRunAtUtc)</dd></div>
                            <div><dt>@UiStrings.DashboardLastSuccess</dt><dd>@DisplayFormat.LocalDateTime(job.LastSuccessAtUtc)</dd></div>
                            <div><dt>@UiStrings.DashboardNextRun</dt><dd>@(job.Lifecycle == JobLifecycle.Active ? DisplayFormat.LocalDateTime(job.NextRunAtUtc, UiStrings.ValueNotScheduled) : UiStrings.DashboardPaused)</dd></div>
                        </dl>
                        <div class="dashboard-storage">
                            <MudText Typo="Typo.body2">
                                <strong>@DisplayFormat.Bytes(job.ManagedArtifactBytes)</strong>
                                @string.Format(CultureInfo.CurrentCulture, Plural.Choose(job.RetentionCount, UiStrings.DashboardStorageAcross_One, UiStrings.DashboardStorageAcross_Few, UiStrings.DashboardStorageAcross_Many), job.ManagedArtifactCount, job.RetentionCount)
                            </MudText>
                            <MudText Typo="Typo.caption">
                                @string.Format(CultureInfo.CurrentCulture, UiStrings.DashboardStorageLatest, DisplayFormat.Bytes(job.LatestArtifactBytes, UiStrings.ValueUnknownDash)) ·
                                @string.Format(CultureInfo.CurrentCulture, UiStrings.DashboardStorageConfirmed, DisplayFormat.LocalDateTime(job.StorageConfirmedAtUtc, UiStrings.ValueNever))
                                @if (job.StorageStale) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">@UiStrings.DashboardStorageStale</MudChip> }
                            </MudText>
                            @if (job.MissingArtifactCount > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@Plural.Format(job.MissingArtifactCount, UiStrings.DashboardMissingArchives_One, UiStrings.DashboardMissingArchives_Few, UiStrings.DashboardMissingArchives_Many)</MudText>
                            }
                            @if (job.UnmanagedArtifactCount > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">@Plural.Format(job.UnmanagedArtifactCount, UiStrings.DashboardUnmanagedArchives_One, UiStrings.DashboardUnmanagedArchives_Few, UiStrings.DashboardUnmanagedArchives_Many)</MudText>
                            }
                            @if (job.LastNotificationState is not null)
                            {
                                <MudText Typo="Typo.caption">
                                    @UiStrings.DashboardNotificationLabel <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.NotificationColor(job.LastNotificationState)">@MonitoringDisplay.NotificationLabel(job.LastNotificationState)</MudChip>
                                </MudText>
                            }
                        </div>
                        <div class="dashboard-card-actions">
                            @if (job.Lifecycle != JobLifecycle.Archived)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="@(busyJobId == job.JobId)" OnClick="() => RunNowAsync(job.JobId)">@UiStrings.DashboardRunNow</MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       Disabled="@(busyJobId == job.JobId)" OnClick="() => RefreshStorageAsync(job.JobId)">@UiStrings.DashboardRefreshStorage</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ViewHistory(job.JobId)">@UiStrings.DashboardHistory</MudButton>
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </section>

    <section class="dashboard-section">
        <MudText Typo="Typo.h5">@UiStrings.DashboardSectionDestinations</MudText>
        <MudList T="string" Dense="true" Class="queue-list">
            @foreach (var destination in destinations)
            {
                <MudListItem T="string" Icon="@(destination.Type == DestinationType.Local ? Icons.Material.Outlined.Storage : Icons.Material.Outlined.Dns)">
                    <strong>@destination.Name</strong> —
                    <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.VerificationColor(destination.VerificationResult)">@MonitoringDisplay.VerificationLabel(destination.VerificationResult)</MudChip>
                    @if (destination.LastAccessedAtUtc is { } accessed)
                    {
                        <span>@string.Format(CultureInfo.CurrentCulture, UiStrings.DashboardLastAccess, MonitoringDisplay.AccessLabel(destination.LastAccessResult), DisplayFormat.LocalDateTime(accessed))</span>
                    }
                    else
                    {
                        <span>@UiStrings.DashboardLastAccessNotAttempted</span>
                    }
                </MudListItem>
            }
        </MudList>
    </section>

}

@code {
    private DashboardView? view;
    private IReadOnlyList<DestinationSummary> destinations = [];
    private bool loading = true;
    private bool reloading;
    private bool reloadRequested;
    private IDisposable? activitySubscription;
    private Guid? busyJobId;
    private string? operationMessage;
    private bool operationError;

    protected override async Task OnInitializedAsync()
    {
        // Subscribed before the first load so that a run claimed or finished while that load is in
        // flight still reaches this page.
        activitySubscription = RunActivity.Subscribe(() => InvokeAsync(ReloadAsync));
        await ReloadAsync();
    }

    /// <summary>
    /// Reloads every durable figure on the page. Signalled reloads and the refresh button share this
    /// path; the spinner belongs to the first load only, so an automatic reload neither flickers nor
    /// tears down the live progress subscription held by the active run panel.
    /// </summary>
    private async Task ReloadAsync()
    {
        if (reloading)
        {
            // A burst of transitions collapses into one further reload rather than a queue of them.
            reloadRequested = true;
            return;
        }

        reloading = true;
        try
        {
            do
            {
                reloadRequested = false;
                view = await DashboardQueries.GetAsync();
                destinations = await DestinationService.ListAsync(includeArchived: false);
                loading = false;
                StateHasChanged();
            }
            while (reloadRequested);
        }
        finally
        {
            reloading = false;
        }
    }

    private async Task RunNowAsync(Guid jobId)
    {
        busyJobId = jobId;
        var outcome = await BackupExecution.RunNowAsync(jobId);
        operationError = outcome.Status != ManualRunEnqueueStatus.Queued;
        operationMessage = MessageText.Resolve(outcome.Message);
        busyJobId = null;
        await ReloadAsync();
    }

    private async Task RefreshStorageAsync(Guid jobId)
    {
        busyJobId = jobId;
        var result = await Retention.ReconcileInventoryAsync(jobId);
        operationError = !result.DestinationReachable;
        operationMessage = result.DestinationReachable
            ? string.Format(
                CultureInfo.CurrentCulture,
                Plural.Choose(
                    result.Checked,
                    UiStrings.DashboardStorageConfirmedResult_One,
                    UiStrings.DashboardStorageConfirmedResult_Few,
                    UiStrings.DashboardStorageConfirmedResult_Many),
                result.Checked,
                result.MarkedMissing)
            : UiStrings.DashboardStorageUnreachable;
        busyJobId = null;
        await ReloadAsync();
    }

    private void ViewHistory(Guid jobId) => Navigation.NavigateTo($"history?job={jobId}");

    // The verification chip's colour and label come from MonitoringDisplay so that a destination reads
    // the same here as it does on the destinations page and in the job form.
    public void Dispose() => activitySubscription?.Dispose();
}
