@inject DestinationService DestinationService

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="name" Label="Name" Required="true" MaxLength="200" Variant="Variant.Outlined" />
                <MudSelect T="DestinationType" @bind-Value="type" Label="Storage type" Variant="Variant.Outlined" Disabled="@(Destination is not null)">
                    <MudSelectItem Value="DestinationType.Local">Local folder</MudSelectItem>
                    <MudSelectItem Value="DestinationType.Smb">SMB network share</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="rootPath" Label="Root path" Required="true" Variant="Variant.Outlined"
                              HelperText="@(type == DestinationType.Local ? @"Example: D:\Backups" : @"Example: \\nas\backups")" />
                @if (type == DestinationType.Smb)
                {
                    <MudTextField @bind-Value="username" Label="Username" Required="true" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="password" Label="@(Destination?.HasPassword == true ? "Replacement password (optional)" : "Password")"
                                  Required="@(Destination?.HasPassword != true)" InputType="InputType.Password" Variant="Variant.Outlined"
                                  HelperText="Saved passwords are never displayed. Leave blank to keep the existing password." />
                }
                @if (error is not null) { <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert> }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="saving" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public DestinationSummary? Destination { get; set; }
    private MudForm form = null!;
    private string name = ""; private DestinationType type; private string rootPath = "";
    private string? username; private string? password; private string? error; private bool saving;
    protected override void OnInitialized()
    {
        if (Destination is null) return;
        name = Destination.Name; type = Destination.Type; rootPath = Destination.RootPath; username = Destination.SmbUsername;
    }
    private void Cancel() => Dialog.Cancel();
    private async Task SaveAsync()
    {
        await form.Validate();
        if (!form.IsValid) return;
        saving = true; error = null;
        try
        {
            var command = new SaveDestinationCommand(name, type, rootPath, username, password);
            if (Destination is null) await DestinationService.CreateAsync(command);
            else await DestinationService.EditAsync(Destination.Id, command);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { error = exception.Message; }
        finally { password = null; saving = false; }
    }
}
