@using System.Globalization
@page "/jobs"
@inject JobService JobService
@inject DestinationService DestinationService
@inject ScheduleOccurrenceCalculator ScheduleCalculator
@inject BackupExecutionService BackupExecution
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>@string.Format(CultureInfo.CurrentCulture, UiStrings.PageTitleFormat, UiStrings.NavJobs)</PageTitle>
<NavigationLock ConfirmExternalNavigation="dirty" OnBeforeInternalNavigation="BeforeInternalNavigation" />

@if (editing)
{
    <div class="page-heading compact-heading">
        <div>
            <MudText Typo="Typo.h1">@(editingId is null ? UiStrings.JobsNew : UiStrings.JobsEdit)</MudText>
            <MudText Class="page-lead">@UiStrings.JobsFormLead</MudText>
        </div>
        <MudButton OnClick="CancelEditAsync">@UiStrings.ActionCancel</MudButton>
    </div>
    <MudPaper Class="job-form" Elevation="0">
        @if (outcome is not null) { <MudAlert Severity="@(outcomeError ? Severity.Error : Severity.Success)" Dense="true">@outcome</MudAlert> }
        <section>
            <MudText Typo="Typo.h5">@UiStrings.JobsSectionIdentity</MudText>
            <div class="form-grid">
                <label class="field"><span>@UiStrings.JobsFieldName</span><input @bind="name" @bind:after="Changed" maxlength="200" />@ErrorFor("Name")</label>
                <label class="field field-wide"><span>@UiStrings.JobsFieldSourceDirectory</span><div class="input-action"><input @bind="sourcePath" @bind:after="Changed" /><button type="button" @onclick="BrowseSourceAsync">@UiStrings.JobsBrowse</button></div>@ErrorFor("SourcePath")</label>
            </div>
            <div class="form-tools">
                <MudButton Variant="Variant.Outlined" Disabled="@string.IsNullOrWhiteSpace(sourcePath)" OnClick="PreviewSourceAsync">@UiStrings.JobsPreviewSource</MudButton>
                @if (previewBytes is long bytes) { <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, UiStrings.JobsPreviewResult, DisplayFormat.Bytes(bytes), RetentionEstimate(bytes, retention))</MudText> }
            </div>
        </section>
        <section>
            <MudText Typo="Typo.h5">@UiStrings.JobsSectionDestination</MudText>
            <div class="form-grid">
                <label class="field"><span>@UiStrings.JobsFieldStorageRoot</span><select value="@destinationId" @onchange="DestinationChanged">
                    <option value="">@UiStrings.JobsChooseDestination</option>
                    @foreach (var destination in destinations) { <option value="@destination.Id">@destination.Name</option> }
                </select>@ErrorFor("DestinationId")</label>
                <label class="field"><span>@UiStrings.JobsFieldSubfolder</span><input @bind="subfolder" @bind:after="Changed" placeholder="@UiStrings.JobsSubfolderPlaceholder" />@ErrorFor("DestinationSubfolder")</label>
            </div>
            @if (SelectedDestination is { } selected)
            {
                <div class="verification-line">
                    <MudChip T="string" Size="Size.Small" Color="@(selected.VerificationResult == DestinationVerificationResult.Succeeded ? Color.Success : Color.Warning)">@MonitoringDisplay.VerificationLabel(selected.VerificationResult)</MudChip>
                    <span>@selected.RootPath</span>
                </div>
            }
            @if (editingId is not null)
            { <MudButton Variant="Variant.Text" OnClick="TestEffectiveFolderAsync">@UiStrings.JobsTestEffectiveFolder</MudButton> }
        </section>
        <section>
            <MudText Typo="Typo.h5">@UiStrings.JobsSectionSchedule</MudText>
            <div class="weekday-row">
                @foreach (var day in weekdayOptions)
                { <label><input type="checkbox" checked="@HasDay(day.Value)" @onchange="args => ToggleDay(day.Value, (bool)(args.Value ?? false))" />@day.Label</label> }
            </div>
            @ErrorFor("Weekdays")
            <div class="form-grid">
                @* The time input's value must stay in the fixed HH:mm form the HTML control parses,
                   which is why this one ToString deliberately does not follow the culture. *@
                <label class="field"><span>@UiStrings.JobsFieldScheduledTime</span><input type="time" value="@scheduledTime.ToString("HH:mm", CultureInfo.InvariantCulture)" @onchange="TimeChanged" /></label>
                <label class="field"><span>@UiStrings.JobsFieldRetention</span><input type="number" min="1" max="100000" @bind="retention" @bind:after="Changed" />@ErrorFor("RetentionCount")</label>
            </div>
            <div class="schedule-summary">
                <span>@UiStrings.JobsCurrentTimezone <strong>@TimeZoneInfo.Local.DisplayName</strong></span>
                <span>@UiStrings.JobsNextRunLabel <strong>@NextRunText</strong></span>
            </div>
            @if (editingDetails is not null)
            { <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, UiStrings.JobsManagedStorage, editingDetails.ManagedArtifactCount.ToString("N0", CultureInfo.CurrentCulture), DisplayFormat.Bytes(editingDetails.ManagedArtifactBytes))</MudText> }
        </section>
        <section class="activation-section">
            @if (editingDetails?.Lifecycle == JobLifecycle.Active)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@UiStrings.JobsCurrentlyActive</MudChip>
                <MudText Typo="Typo.caption">@UiStrings.JobsLifecycleNote</MudText>
            }
            else
            {
                <label><input type="checkbox" @bind="activate" @bind:after="Changed" /> @(editingDetails is null ? UiStrings.JobsActivateThis : UiStrings.JobsActivateAfterSaving)</label>
                <MudText Typo="Typo.caption">@UiStrings.JobsActivationNote</MudText>
            }
        </section>
        <div class="form-footer">
            <MudButton OnClick="CancelEditAsync">@UiStrings.ActionCancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="saving" OnClick="SaveAsync">@(saving ? UiStrings.JobsSaving : UiStrings.JobsSave)</MudButton>
        </div>
    </MudPaper>
}
else
{
    <div class="page-heading">
        <div><MudText Typo="Typo.h1">@UiStrings.JobsTitle</MudText><MudText Class="page-lead">@UiStrings.JobsLead</MudText></div>
        <MudStack Row="true">
            <MudButton Variant="@(showArchived ? Variant.Outlined : Variant.Text)" OnClick="ToggleArchivedAsync">@(showArchived ? UiStrings.JobsShowCurrent : UiStrings.JobsShowArchived)</MudButton>
            @if (!showArchived) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewJob">@UiStrings.JobsNew</MudButton> }
        </MudStack>
    </div>
    @if (outcome is not null) { <MudAlert Severity="@(outcomeError ? Severity.Error : Severity.Success)" Class="mb-4">@outcome</MudAlert> }
    @if (loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (VisibleJobs.Count == 0)
    {
        <MudPaper Class="destination-empty" Elevation="0"><MudIcon Icon="@Icons.Material.Outlined.FolderCopy" Size="Size.Large" /><MudText Typo="Typo.h5">@(showArchived ? UiStrings.JobsEmptyArchivedHeading : UiStrings.JobsEmptyCurrentHeading)</MudText><MudText>@(showArchived ? UiStrings.JobsEmptyArchivedBody : UiStrings.JobsEmptyCurrentBody)</MudText></MudPaper>
    }
    else
    {
        <div class="job-list">
            @foreach (var job in VisibleJobs)
            {
                <MudPaper Class="job-card" Elevation="0">
                    <div class="job-card-main">
                        <div><MudText Typo="Typo.h5">@job.Name</MudText><MudText Typo="Typo.caption">@MonitoringDisplay.LifecycleLabel(job.Lifecycle).ToUpper(CultureInfo.CurrentCulture)</MudText></div>
                        <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.LifecycleColor(job.Lifecycle)">@MonitoringDisplay.LifecycleLabel(job.Lifecycle)</MudChip>
                    </div>
                    <div class="job-route"><span>@job.SourcePath</span><MudIcon Icon="@Icons.Material.Filled.ArrowForward" /><span>@DestinationName(job.DestinationId)\@job.DestinationSubfolder</span></div>
                    <MudText Typo="Typo.body2">@ScheduleSummary(job)</MudText>
                    <div class="destination-actions">
                        @if (job.Lifecycle == JobLifecycle.Archived)
                        { <MudButton Variant="Variant.Outlined" OnClick="() => RestoreAsync(job)">@UiStrings.ActionRestore</MudButton> }
                        else
                        {
                             <MudButton Variant="Variant.Text" OnClick="() => EditAsync(job.Id)">@UiStrings.ActionEdit</MudButton>
                             <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="() => RunNowAsync(job)">@UiStrings.JobsRunNow</MudButton>
                            @if (job.Lifecycle == JobLifecycle.Active) { <MudButton Variant="Variant.Outlined" OnClick="() => TransitionAsync(job, JobLifecycle.Paused)">@UiStrings.JobsPause</MudButton> }
                            else { <MudButton Variant="Variant.Outlined" OnClick="() => TransitionAsync(job, JobLifecycle.Active)">@UiStrings.JobsReactivate</MudButton> }
                            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="() => ArchiveAsync(job)">@UiStrings.ActionArchive</MudButton>
                        }
                    </div>
                </MudPaper>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<JobSummary> jobs = [];
    private IReadOnlyList<DestinationSummary> destinations = [];
    // Built from the reading culture's own day names, in the culture's own order, rather than from the
    // enumeration's member names. A Slovak interface therefore lists Monday first with Slovak
    // abbreviations, matching the calendar's month grid.
    private IReadOnlyList<(ScheduledWeekdays Value, string Label)> weekdayOptions = WeekdayDisplay.Options();
    private readonly Dictionary<string, string> errors = new(StringComparer.OrdinalIgnoreCase);
    private bool loading = true, showArchived, editing, dirty, saving, activate, outcomeError;
    private Guid? editingId;
    private JobDetails? editingDetails;
    private string name = "", sourcePath = "", subfolder = "", outcome = null!;
    private Guid destinationId;
    private ScheduledWeekdays weekdays = ScheduledWeekdays.Monday;
    private TimeOnly scheduledTime = new(2, 0);
    private int retention = 7;
    private long? previewBytes;
    private IReadOnlyList<JobSummary> VisibleJobs => jobs.Where(x => showArchived ? x.Lifecycle == JobLifecycle.Archived : x.Lifecycle != JobLifecycle.Archived).ToArray();
    private DestinationSummary? SelectedDestination => destinations.FirstOrDefault(x => x.Id == destinationId);

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        loading = true;
        var jobsTask = JobService.ListAsync(includeArchived: true);
        var destinationsTask = DestinationService.ListAsync();
        await Task.WhenAll(jobsTask, destinationsTask);
        jobs = jobsTask.Result; destinations = destinationsTask.Result; loading = false;
    }

    private async Task RunNowAsync(JobSummary job)
    {
        var result = await BackupExecution.RunNowAsync(job.Id);
        outcome = MessageText.Resolve(result.Message);
        outcomeError = result.RunId is null;
    }
    private void NewJob() { ResetForm(); editing = true; }
    private async Task EditAsync(Guid id)
    {
        var details = await JobService.GetAsync(id);
        if (details is null) { SetOutcome(UiStrings.JobsNotFound, true); return; }
        editingDetails = details; editingId = id; name = details.Name; sourcePath = details.SourcePath;
        destinationId = details.DestinationId; subfolder = details.DestinationSubfolder; weekdays = details.Weekdays;
        scheduledTime = details.ScheduledTime; retention = details.RetentionCount; activate = details.Lifecycle == JobLifecycle.Active;
        errors.Clear(); outcome = null!; dirty = false; editing = true;
    }
    private void ResetForm()
    {
        editingId = null; editingDetails = null; name = sourcePath = subfolder = ""; destinationId = Guid.Empty;
        weekdays = ScheduledWeekdays.Monday; scheduledTime = new(2, 0); retention = 7; activate = false;
        previewBytes = null; errors.Clear(); outcome = null!; dirty = false;
    }
    private void Changed() => dirty = true;
    private async Task SaveAsync()
    {
        errors.Clear(); outcome = null!;
        if (string.IsNullOrWhiteSpace(name)) errors["Name"] = UiStrings.JobsValidationName;
        if (string.IsNullOrWhiteSpace(sourcePath)) errors["SourcePath"] = UiStrings.JobsValidationSourcePath;
        if (destinationId == Guid.Empty) errors["DestinationId"] = UiStrings.JobsValidationDestination;
        if (weekdays == ScheduledWeekdays.None) errors["Weekdays"] = UiStrings.JobsValidationWeekdays;
        if (retention < 1) errors["RetentionCount"] = UiStrings.JobsValidationRetention;
        if (errors.Count != 0) return;
        saving = true;
        try
        {
            var command = new SaveJobCommand(name, sourcePath, destinationId, subfolder, weekdays, scheduledTime, retention, activate);
            var result = editingId is Guid id ? await JobService.EditAsync(id, command) : await JobService.CreateAsync(command);
            if (!result.Succeeded && result.ValidationErrors?.Any(x => x.Field == "ConfirmDestinationPathChange") == true && editingId is Guid changedId)
            {
                if (await DialogService.ShowMessageBoxAsync(
                        UiStrings.JobsChangeDestinationTitle,
                        UiStrings.JobsChangeDestinationBody,
                        yesText: UiStrings.JobsChangeDestinationConfirm,
                        cancelText: UiStrings.JobsChangeDestinationKeep) == true)
                    result = await JobService.EditAsync(changedId, command with { ConfirmDestinationPathChange = true });
            }
            if (!result.Succeeded)
            {
                foreach (var error in result.ValidationErrors ?? []) errors[error.Field] = MessageText.Resolve(error.Message);
                SetOutcome(MessageText.Resolve(result.Message), true); return;
            }
            dirty = false; editing = false; SetOutcome(MessageText.Resolve(result.Message), false); await ReloadAsync();
        }
        catch (Exception)
        {
            SetOutcome(UiStrings.JobsSaveFailed, true);
        }
        finally
        {
            saving = false;
        }
    }
    private async Task BrowseSourceAsync()
    {
        var parameters = new DialogParameters { [nameof(SourceBrowserDialog.InitialPath)] = sourcePath };
        var dialog = await DialogService.ShowAsync<SourceBrowserDialog>(UiStrings.SourceBrowserTitle, parameters, new() { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });
        var result = await dialog.Result;
        if (result?.Canceled == false && result.Data is string path) { sourcePath = path; Changed(); }
    }
    private async Task PreviewSourceAsync()
    {
        var parameters = new DialogParameters { [nameof(SourcePreviewDialog.Path)] = sourcePath };
        var dialog = await DialogService.ShowAsync<SourcePreviewDialog>(UiStrings.SourcePreviewTitle, parameters, new() { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });
        var result = await dialog.Result;
        if (result?.Data is SourcePreviewSnapshot snapshot) previewBytes = snapshot.TotalBytes;
    }
    private async Task TestEffectiveFolderAsync()
    {
        if (dirty)
        { SetOutcome(UiStrings.JobsSaveBeforeTesting, true); return; }
        try
        {
            var parameters = new DialogParameters { [nameof(EffectiveFolderTestDialog.JobId)] = editingId!.Value };
            var dialog = await DialogService.ShowAsync<EffectiveFolderTestDialog>(UiStrings.EffectiveFolderTestTitle, parameters,
                new() { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false });
            await dialog.Result;
        }
        catch (Exception)
        {
            SetOutcome(UiStrings.JobsTestOpenFailed, true);
        }
    }
    private async Task TransitionAsync(JobSummary job, JobLifecycle target)
    {
        // The title, the question, and the confirming button were previously derived from one English
        // verb by capitalising its first letter. That cannot survive translation, so each language
        // supplies the three strings it needs.
        var pausing = target == JobLifecycle.Paused;
        var title = pausing ? UiStrings.JobsPauseTitle : UiStrings.JobsReactivateTitle;
        var body = string.Format(
            CultureInfo.CurrentCulture,
            pausing ? UiStrings.JobsPauseBody : UiStrings.JobsReactivateBody,
            job.Name);
        var confirm = pausing ? UiStrings.JobsPause : UiStrings.JobsReactivate;
        if (await DialogService.ShowMessageBoxAsync(title, body, yesText: confirm, cancelText: UiStrings.ActionCancel) != true) return;
        await ApplyLifecycleAsync(() => target == JobLifecycle.Paused
            ? JobService.PauseAsync(job.Id)
            : JobService.ReactivateAsync(job.Id));
    }
    private async Task ArchiveAsync(JobSummary job)
    {
        if (await DialogService.ShowMessageBoxAsync(
                UiStrings.JobsArchiveTitle,
                string.Format(CultureInfo.CurrentCulture, UiStrings.JobsArchiveBody, job.Name),
                yesText: UiStrings.ActionArchive,
                cancelText: UiStrings.ActionCancel) != true) return;
        await ApplyLifecycleAsync(() => JobService.ArchiveAsync(job.Id));
    }
    private async Task RestoreAsync(JobSummary job)
    {
        if (await DialogService.ShowMessageBoxAsync(
                UiStrings.JobsRestoreTitle,
                string.Format(CultureInfo.CurrentCulture, UiStrings.JobsRestoreBody, job.Name),
                yesText: UiStrings.ActionRestore,
                cancelText: UiStrings.ActionCancel) != true) return;
        await ApplyLifecycleAsync(() => JobService.RestoreAsync(job.Id, restoreActive: true));
    }
    private async Task ApplyLifecycleAsync(Func<Task<JobOperationResult>> operation)
    {
        try
        {
            var result = await operation();
            SetOutcome(MessageText.Resolve(result.Message), !result.Succeeded);
            await ReloadAsync();
        }
        catch (Exception)
        {
            SetOutcome(UiStrings.JobsLifecycleFailed, true);
        }
    }
    private async Task ToggleArchivedAsync() { showArchived = !showArchived; await ReloadAsync(); }
    private async Task CancelEditAsync()
    {
        if (dirty && await DialogService.ShowMessageBoxAsync(
                UiStrings.JobsDiscardTitle,
                UiStrings.JobsDiscardBody,
                yesText: UiStrings.JobsDiscardConfirm,
                cancelText: UiStrings.JobsDiscardKeep) != true) return;
        dirty = false; editing = false;
    }
    private async Task BeforeInternalNavigation(LocationChangingContext context)
    {
        if (!dirty) return;
        context.PreventNavigation();
        if (await DialogService.ShowMessageBoxAsync(
                UiStrings.JobsLeaveTitle,
                UiStrings.JobsDiscardBody,
                yesText: UiStrings.JobsLeaveConfirm,
                cancelText: UiStrings.JobsLeaveStay) == true)
        { dirty = false; Navigation.NavigateTo(context.TargetLocation); }
    }
    private void DestinationChanged(ChangeEventArgs args) { Guid.TryParse(args.Value?.ToString(), out destinationId); Changed(); }
    private void TimeChanged(ChangeEventArgs args) { if (TimeOnly.TryParse(args.Value?.ToString(), out var value)) scheduledTime = value; Changed(); }
    private bool HasDay(ScheduledWeekdays day) => (weekdays & day) != 0;
    private void ToggleDay(ScheduledWeekdays day, bool enabled) { weekdays = enabled ? weekdays | day : weekdays & ~day; Changed(); }
    private RenderFragment ErrorFor(string field) => builder => { if (errors.TryGetValue(field, out var message)) builder.AddContent(0, message); };
    private void SetOutcome(string message, bool error) { outcome = message; outcomeError = error; }
    private string NextRunText => weekdays == ScheduledWeekdays.None ? UiStrings.JobsSelectAWeekday : NextRun(weekdays, scheduledTime, editingDetails?.ScheduleRevision ?? 1, editingDetails?.ScheduleEffectiveFromUtc ?? DateTimeOffset.UtcNow);
    private string NextRun(JobSummary job) => NextRun(job.Weekdays, job.ScheduledTime, job.ScheduleRevision, job.ScheduleEffectiveFromUtc);
    private string NextRun(ScheduledWeekdays days, TimeOnly time, long revision, DateTimeOffset effective)
    {
        // Routed through the shared display helper rather than formatting inline, so that the weekday
        // name and the date pattern both follow the reading culture. This call used to pass no culture
        // at all and printed English weekday abbreviations whatever the interface language.
        try { return DisplayFormat.LocalDayAndTime(ScheduleCalculator.GetNextOccurrence(new(new(days), new(time), revision, effective), TimeZoneInfo.Local).OccursAtUtc); }
        catch (ArgumentException) { return UiStrings.JobsScheduleIncomplete; }
    }
    private string ScheduleSummary(JobSummary job) => string.Format(
        CultureInfo.CurrentCulture,
        UiStrings.JobsScheduleSummary,
        WeekdayDisplay.Summarize(job.Weekdays),
        job.ScheduledTime.ToString("t", CultureInfo.CurrentCulture),
        NextRun(job));
    private string DestinationName(Guid id) => destinations.FirstOrDefault(x => x.Id == id)?.Name ?? UiStrings.JobsUnavailableDestination;
    private static string RetentionEstimate(long bytes, int count) { try { return DisplayFormat.Bytes(checked(bytes * (long)Math.Max(1, count))); } catch (OverflowException) { return UiStrings.JobsRetentionOverflow; } }
}
