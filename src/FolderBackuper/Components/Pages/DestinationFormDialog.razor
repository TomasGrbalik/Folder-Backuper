@inject DestinationService DestinationService
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="name" Label="@UiStrings.DestinationFormName" Required="true" MaxLength="200" Variant="Variant.Outlined" />
                <MudSelect T="DestinationType" @bind-Value="type" Label="@UiStrings.DestinationFormStorageType" Variant="Variant.Outlined" Disabled="@(Destination is not null)">
                    <MudSelectItem Value="DestinationType.Local">@UiStrings.DestinationFormLocalFolder</MudSelectItem>
                    <MudSelectItem Value="DestinationType.Smb">@UiStrings.DestinationFormSmbShare</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="rootPath" Label="@UiStrings.DestinationFormRootPath" Required="true" Variant="Variant.Outlined"
                              HelperText="@(type == DestinationType.Local ? UiStrings.DestinationFormLocalExample : UiStrings.DestinationFormSmbExample)" />
                @if (type == DestinationType.Smb)
                {
                    <MudTextField @bind-Value="username" Label="@UiStrings.DestinationFormUsername" Required="true" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="password" Label="@(Destination?.HasPassword == true ? UiStrings.DestinationFormPasswordReplacement : UiStrings.DestinationFormPassword)"
                                  Required="@(Destination?.HasPassword != true)" InputType="InputType.Password" Variant="Variant.Outlined"
                                  HelperText="@UiStrings.DestinationFormPasswordHelp" />
                }
                @if (error is not null) { <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert> }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@UiStrings.ActionCancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="saving" OnClick="SaveAsync">@UiStrings.ActionSave</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public DestinationSummary? Destination { get; set; }
    private MudForm form = null!;
    private string name = ""; private DestinationType type; private string rootPath = "";
    private string? username; private string? password; private string? error; private bool saving;
    protected override void OnInitialized()
    {
        if (Destination is null) return;
        name = Destination.Name; type = Destination.Type; rootPath = Destination.RootPath; username = Destination.SmbUsername;
    }
    private void Cancel() => Dialog.Cancel();
    private async Task SaveAsync()
    {
        await form.Validate();
        if (!form.IsValid) return;
        saving = true; error = null;
        try
        {
            var command = new SaveDestinationCommand(name, type, rootPath, username, password);
            if (Destination is null)
            {
                await DestinationService.CreateAsync(command);
            }
            else
            {
                var result = await DestinationService.EditAsync(Destination.Id, command);
                if (!result.Succeeded && result.Status == DestinationOperationStatus.ValidationFailed &&
                    result.Message.Key == UiMessage.KeyFor(DestinationMessage.RootChangeNeedsConfirmation))
                {
                    var confirmed = await DialogService.ShowMessageBoxAsync(
                        UiStrings.DestinationFormChangeRootTitle,
                        UiStrings.DestinationFormChangeRootBody,
                        yesText: UiStrings.DestinationFormChangeRootConfirm,
                        cancelText: UiStrings.DestinationFormChangeRootKeep);
                    if (confirmed == true)
                        result = await DestinationService.EditAsync(Destination.Id, command with { ConfirmRootPathChange = true });
                }
                if (!result.Succeeded) { error = MessageText.Resolve(result.Message); return; }
            }
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (DestinationValidationException rejected) { error = MessageText.Resolve(rejected.Reason); }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            // A rejected configuration carries its reason as a code; anything else reports a generic
            // localized failure rather than surfacing the exception's own untranslatable text.
            error = UiStrings.DestinationFormSaveFailed;
        }
        finally { password = null; saving = false; }
    }
}
