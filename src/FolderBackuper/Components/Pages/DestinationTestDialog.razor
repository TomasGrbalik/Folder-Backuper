@inject DestinationService DestinationService

<MudDialog>
    <DialogContent>
        @if (testing)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText>Writing and reading a private test file at @Destination.Name...</MudText>
            </MudStack>
        }
        else if (result is not null)
        {
            <MudAlert Severity="@(result.Succeeded ? Severity.Success : Severity.Error)">@result.Message</MudAlert>
            @if (result.AvailableBytes is long bytes) { <MudText Class="mt-3">@($"{bytes:N0} bytes available")</MudText> }
        }
    </DialogContent>
    <DialogActions><MudButton Color="Color.Primary" Disabled="testing" OnClick="Close">Close</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public DestinationSummary Destination { get; set; } = null!;
    private bool testing = true;
    private DestinationOperationResult? result;
    protected override async Task OnInitializedAsync() { result = await DestinationService.TestAsync(Destination.Id); testing = false; }
    private void Close() => Dialog.Close();
}
