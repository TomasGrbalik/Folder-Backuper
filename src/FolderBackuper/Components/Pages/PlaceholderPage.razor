<header class="page-heading">
    <div>
        <MudText Typo="Typo.overline">Workspace</MudText>
        <MudText Typo="Typo.h2" HtmlTag="h1">@Title</MudText>
    </div>
</header>
<MudPaper Class="placeholder-card" Elevation="0">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h5">Foundation ready</MudText>
    <MudText>@Description</MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string Description { get; set; }

    [Parameter, EditorRequired]
    public required string Icon { get; set; }
}
