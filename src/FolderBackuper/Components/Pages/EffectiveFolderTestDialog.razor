@inject JobService JobService

<MudDialog>
    <DialogContent>
        @if (testing)
        {
            <MudStack AlignItems="AlignItems.Center"><MudProgressCircular Indeterminate="true" /><MudText>@UiStrings.EffectiveFolderTestRunning</MudText></MudStack>
        }
        else if (outcome is not null)
        {
            <MudAlert Severity="@(outcome.Succeeded ? Severity.Success : Severity.Error)">@MessageText.Resolve(outcome.Message)</MudAlert>
        }
        else { <MudAlert Severity="Severity.Error">@UiStrings.EffectiveFolderTestMissing</MudAlert> }
    </DialogContent>
    <DialogActions><MudButton Disabled="testing" Color="Color.Primary" OnClick="Close">@UiStrings.ActionClose</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid JobId { get; set; }
    private JobOperationResult? outcome;
    private bool testing = true;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            outcome = await JobService.TestDestinationAsync(JobId);
        }
        catch (Exception)
        {
            outcome = new(JobOperationStatus.Failed, JobMessage.EffectiveFolderTestFailed);
        }
        finally
        {
            testing = false;
        }
    }
    private void Close() => Dialog.Close();
}
