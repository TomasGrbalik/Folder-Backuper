@using System.Globalization
@page "/history"
@implements IDisposable
@inject RunQueryService Runs
@inject RunActivitySignal RunActivity
@inject JobService JobService
@inject IDialogService DialogService

<PageTitle>@string.Format(CultureInfo.CurrentCulture, UiStrings.PageTitleFormat, UiStrings.NavHistory)</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h1">@UiStrings.HistoryTitle</MudText>
        <MudText Class="page-lead">@UiStrings.HistoryLead</MudText>
    </div>
</div>

<div class="history-filters">
    <MudSelect T="Guid?" Value="jobFilter" ValueChanged="OnJobFilterChanged" Label="@UiStrings.FilterJob" Dense="true" Clearable="true" Class="filter-control">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">@UiStrings.FilterAllJobs</MudSelectItem>
        @foreach (var job in jobs)
        {
            <MudSelectItem T="Guid?" Value="@job.Id">@job.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="RunStatusFilter" Value="statusFilter" ValueChanged="OnStatusFilterChanged" Label="@UiStrings.FilterStatus" Dense="true" Class="filter-control">
        @foreach (var status in Enum.GetValues<RunStatusFilter>())
        {
            <MudSelectItem T="RunStatusFilter" Value="@status">@EnumText.For(status)</MudSelectItem>
        }
    </MudSelect>
</div>

<MudTable T="RunHistoryRow" ServerData="LoadAsync" @ref="table" Hover="true" Dense="true" Class="history-table"
          OnRowClick="OpenDetailsAsync" RowsPerPage="RunQueryService.DefaultPageSize">
    <HeaderContent>
        <MudTh>@UiStrings.HistoryColumnJob</MudTh>
        <MudTh>@UiStrings.HistoryColumnTrigger</MudTh>
        <MudTh>@UiStrings.HistoryColumnStatus</MudTh>
        <MudTh>@UiStrings.HistoryColumnStarted</MudTh>
        <MudTh>@UiStrings.HistoryColumnDuration</MudTh>
        <MudTh>@UiStrings.HistoryColumnArchive</MudTh>
        <MudTh>@UiStrings.HistoryColumnNotification</MudTh>
        <MudTh>@UiStrings.HistoryColumnProblems</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@UiStrings.HistoryColumnJob">@context.JobName</MudTd>
        <MudTd DataLabel="@UiStrings.HistoryColumnTrigger">@MonitoringDisplay.TriggerLabel(context.Trigger)</MudTd>
        <MudTd DataLabel="@UiStrings.HistoryColumnStatus">
            <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.StatusColor(context.Outcome, context.Phase)">@MonitoringDisplay.StatusLabel(context.Outcome, context.Phase)</MudChip>
        </MudTd>
        <MudTd DataLabel="@UiStrings.HistoryColumnStarted">@DisplayFormat.LocalDateTime(context.StartedAtUtc)</MudTd>
        <MudTd DataLabel="@UiStrings.HistoryColumnDuration">@DisplayFormat.Duration(context.Duration)</MudTd>
        <MudTd DataLabel="@UiStrings.HistoryColumnArchive">
            @if (context.ArtifactState is { } artifactState)
            {
                <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.ArtifactColor(artifactState)">@MonitoringDisplay.ArtifactLabel(artifactState)</MudChip>
            }
            else
            {
                <span>@UiStrings.ValueUnknownDash</span>
            }
        </MudTd>
        <MudTd DataLabel="@UiStrings.HistoryColumnNotification">
            <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.NotificationColor(context.NotificationState)">@MonitoringDisplay.NotificationLabel(context.NotificationState)</MudChip>
        </MudTd>
        <MudTd DataLabel="@UiStrings.HistoryColumnProblems">@context.ProblemCount.ToString("N0", CultureInfo.CurrentCulture)</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@UiStrings.HistoryNoRecords</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 50, 100, 200 }" RowsPerPageString="@UiStrings.PagerRowsPerPage" InfoFormat="@UiStrings.PagerInfoFormat" />
    </PagerContent>
</MudTable>

@code {
    [SupplyParameterFromQuery(Name = "job")] private Guid? JobQuery { get; set; }

    private MudTable<RunHistoryRow>? table;
    private IReadOnlyList<JobSummary> jobs = [];
    private Guid? jobFilter;
    private RunStatusFilter statusFilter = RunStatusFilter.All;
    private bool reloading;
    private bool reloadRequested;
    private IDisposable? activitySubscription;

    protected override async Task OnInitializedAsync()
    {
        activitySubscription = RunActivity.Subscribe(() => InvokeAsync(ReloadAsync));
        jobs = await JobService.ListAsync(includeArchived: true);
        if (JobQuery is { } job && jobs.Any(x => x.Id == job))
        {
            jobFilter = job;
        }
    }

    /// <summary>
    /// Re-runs the current query. The table keeps its page and page size, so a run that starts or finishes
    /// updates the rows in place instead of moving them under the reader. Before the first render there is
    /// no table to reload and none is needed: it loads the current state itself.
    /// </summary>
    private async Task ReloadAsync()
    {
        if (table is null)
        {
            return;
        }

        if (reloading)
        {
            // A burst of transitions collapses into one further reload rather than a queue of them.
            reloadRequested = true;
            return;
        }

        reloading = true;
        try
        {
            do
            {
                reloadRequested = false;
                await table.ReloadServerData();
            }
            while (reloadRequested);
        }
        finally
        {
            reloading = false;
        }
    }

    private async Task<TableData<RunHistoryRow>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        var page = await Runs.ListHistoryAsync(
            new RunHistoryFilter(jobFilter, statusFilter), state.Page, state.PageSize, cancellationToken);
        return new TableData<RunHistoryRow> { Items = page.Rows, TotalItems = page.TotalCount };
    }

    private async Task OnJobFilterChanged(Guid? value)
    {
        jobFilter = value;
        await ReloadAsync();
    }

    private async Task OnStatusFilterChanged(RunStatusFilter value)
    {
        statusFilter = value;
        await ReloadAsync();
    }

    private async Task OpenDetailsAsync(TableRowClickEventArgs<RunHistoryRow> args)
    {
        if (args.Item is null)
        {
            return;
        }

        var parameters = new DialogParameters { [nameof(RunDetailsDialog.RunId)] = args.Item.RunId };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<RunDetailsDialog>(UiStrings.RunDetailsTitle, parameters, options);
    }

    // The status filter's labels used to be spelled out here and again in Calendar.razor. Both now go
    // through EnumText, which derives the resource key from the member, so the two pages cannot drift.
    public void Dispose() => activitySubscription?.Dispose();
}
