@using System.Globalization
<nav aria-label="@UiStrings.NavPrimaryLabel" class="nav-shell">
    <MudText Typo="Typo.overline" Class="nav-heading">@UiStrings.NavSectionWorkspace</MudText>
    <MudNavMenu>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">@UiStrings.NavDashboard</MudNavLink>
        <MudNavLink Href="jobs" Icon="@Icons.Material.Filled.FolderCopy">@UiStrings.NavJobs</MudNavLink>
        <MudNavLink Href="destinations" Icon="@Icons.Material.Filled.Storage">@UiStrings.NavDestinations</MudNavLink>
        <MudNavLink Href="calendar" Icon="@Icons.Material.Filled.CalendarMonth">@UiStrings.NavCalendar</MudNavLink>
        <MudNavLink Href="history" Icon="@Icons.Material.Filled.History">@UiStrings.NavHistory</MudNavLink>
        <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">@UiStrings.NavSettings</MudNavLink>
    </MudNavMenu>
    <div class="nav-footer">
        <div class="nav-note">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
            <span>@UiStrings.NavLoopbackOnly</span>
        </div>
        <div class="nav-note">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" />
            <span>@string.Format(CultureInfo.CurrentCulture, UiStrings.NavVersion, ProductVersion.Display)</span>
        </div>
    </div>
</nav>

@code {
    // The version itself is invariant text; only the sentence around it is translated.
}
