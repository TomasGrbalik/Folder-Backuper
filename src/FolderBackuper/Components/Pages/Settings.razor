@using System.Globalization
@page "/settings"
@using FolderBackuper.Features.Notifications
@inject NotificationSettingsService NotificationSettings
@inject UpdateCheckSettingsService UpdateCheckSettings
@inject UiLanguageSettingsService Languages
@inject UpdateCheckService UpdateChecks
@inject UpdateStatusStore Updates
@inject IDialogService DialogService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@string.Format(CultureInfo.CurrentCulture, UiStrings.PageTitleFormat, UiStrings.NavSettings)</PageTitle>
<NavigationLock ConfirmExternalNavigation="dirty" OnBeforeInternalNavigation="BeforeInternalNavigation" />

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h1">@UiStrings.SettingsTitle</MudText>
        <MudText Class="page-lead">@UiStrings.SettingsLead</MudText>
    </div>
</div>

@if (outcome is not null)
{
    <MudAlert Severity="@(outcomeError ? Severity.Error : Severity.Success)" Class="mb-4">@outcome</MudAlert>
}

@if (loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="settings-panel">
        <MudPaper Class="job-form" Elevation="0">
            <section>
                <MudText Typo="Typo.h5">@UiStrings.SettingsEmailHeading</MudText>
                <MudText Typo="Typo.body2" Class="page-lead">@UiStrings.SettingsEmailLead</MudText>
                <label class="field field-wide">
                    <span>
                        <input type="checkbox" checked="@enabled" @onchange="EnabledChanged" />
                        @UiStrings.SettingsEmailEnable
                    </span>
                </label>
            </section>

            <section>
                <MudText Typo="Typo.h5">@UiStrings.SettingsResendHeading</MudText>
                <MudText Typo="Typo.body2" Class="page-lead">@UiStrings.SettingsResendLead</MudText>
                <div class="form-grid">
                    <label class="field">
                        <span>@UiStrings.SettingsApiKey@(view.HasApiKey ? UiStrings.SettingsApiKeyReplacement : "")</span>
                        <input type="password" @bind="apiKey" @bind:after="Changed" autocomplete="new-password"
                               placeholder="@(view.HasApiKey ? UiStrings.SettingsApiKeyKeepPlaceholder : "re_...")" />
                        @ErrorFor(nameof(SaveNotificationSettingsCommand.ApiKey))
                    </label>
                    <label class="field">
                        <span>@UiStrings.SettingsSenderAddress</span>
                        <input @bind="fromAddress" @bind:after="Changed" maxlength="320"
                               placeholder="backups@example.com" />
                        @ErrorFor(nameof(SaveNotificationSettingsCommand.FromAddress))
                    </label>
                    <label class="field">
                        <span>@UiStrings.SettingsSenderName</span>
                        <input @bind="fromName" @bind:after="Changed" maxlength="200" placeholder="Folder Backuper" />
                        @ErrorFor(nameof(SaveNotificationSettingsCommand.FromName))
                    </label>
                </div>
                <MudText Typo="Typo.caption">@UiStrings.SettingsApiKeyNote</MudText>
            </section>

            <section>
                <MudText Typo="Typo.h5">@UiStrings.SettingsRecipientsHeading</MudText>
                <div class="form-grid">
                    <label class="field field-wide">
                        <span>@UiStrings.SettingsRecipientAddresses</span>
                        <textarea rows="4" @bind="recipients" @bind:after="Changed"
                                  placeholder="operator@example.com"></textarea>
                        @ErrorFor(nameof(SaveNotificationSettingsCommand.Recipients))
                    </label>
                </div>
                <MudText Typo="Typo.caption">@UiStrings.SettingsRecipientsNote</MudText>
            </section>

            <section>
                <MudText Typo="Typo.h5">@UiStrings.SettingsVerificationHeading</MudText>
                <div class="verification-line">
                    <MudChip T="string" Size="Size.Small" Color="@(view.IsDeliverable ? Color.Success : Color.Default)">
                        @(view.IsDeliverable ? UiStrings.SettingsReadyToSend : UiStrings.SettingsNotConfigured)
                    </MudChip>
                    <span>@SavedText</span>
                </div>
                <div class="form-tools">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.MarkEmailRead"
                               Disabled="@(saving || !view.IsDeliverable)" OnClick="SendTestAsync">
                        @UiStrings.SettingsSendTestEmail
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption">@UiStrings.SettingsTestEmailNote</MudText>
            </section>

            <div class="form-footer">
                <MudButton Disabled="@(saving || !dirty)" OnClick="ReloadAsync">@UiStrings.SettingsDiscardChanges</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="saving" OnClick="SaveAsync">
                    @(saving ? UiStrings.SettingsSaving : UiStrings.SettingsSave)
                </MudButton>
            </div>
        </MudPaper>

        <MudPaper Class="job-form" Elevation="0">
            <section>
                <MudText Typo="Typo.h5">@UiStrings.SettingsLanguageHeading</MudText>
                <MudText Typo="Typo.body2" Class="page-lead">@UiStrings.SettingsLanguageLead</MudText>
                <div class="form-grid">
                    <label class="field">
                        <span>@UiStrings.SettingsLanguageLabel</span>
                        <select value="@language" @onchange="LanguageChanged">
                            @foreach (var option in InterfaceLanguages.All)
                            {
                                <option value="@option" lang="@option.ToLanguageTag()">@LanguageName(option)</option>
                            }
                        </select>
                    </label>
                </div>
                <MudText Typo="Typo.caption">@UiStrings.SettingsLanguageReloadNote</MudText>
            </section>
        </MudPaper>

        <MudPaper Class="job-form" Elevation="0">
            <section>
                <MudText Typo="Typo.h5">@UiStrings.SettingsAboutHeading</MudText>
                <div class="verification-line">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(updateStatus.UpdateAvailable ? Color.Info : Color.Default)">
                        @string.Format(CultureInfo.CurrentCulture, UiStrings.SettingsVersionChip, updateStatus.InstalledDisplay)
                    </MudChip>
                    <span>@BuildText</span>
                </div>
                <MudText Typo="Typo.body2" Class="page-lead">@UiStrings.SettingsUpdateLead</MudText>
                <label class="field field-wide">
                    <span>
                        <input type="checkbox" checked="@updateCheckEnabled" @onchange="UpdateCheckEnabledChanged" />
                        @UiStrings.SettingsUpdateCheckEnable
                    </span>
                </label>
                <div class="form-tools">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh"
                               Disabled="@(checkingForUpdate || !updateCheckEnabled)" OnClick="CheckForUpdateAsync">
                        @(checkingForUpdate ? UiStrings.SettingsChecking : UiStrings.SettingsCheckNow)
                    </MudButton>
                    @if (updateStatus.UpdateAvailable)
                    {
                        <MudLink Href="@updateStatus.DownloadUrl" Target="_blank" rel="noopener noreferrer">
                            @string.Format(CultureInfo.CurrentCulture, UiStrings.SettingsUpdateAvailableLink, updateStatus.LatestDisplay)
                        </MudLink>
                    }
                </div>
                <MudText Typo="Typo.caption">@UpdateCheckText</MudText>
            </section>
        </MudPaper>
    </div>
}

@code {
    private NotificationSettingsView view = new(false, null, null, [], false, null);
    private Dictionary<string, string> errors = new(StringComparer.Ordinal);
    private bool enabled;
    private string apiKey = "";
    private string fromAddress = "";
    private string fromName = "";
    private string recipients = "";
    private bool loading = true;
    private bool saving;
    private bool dirty;
    private string? outcome;
    private bool outcomeError;

    // The language card, like the about card below, is saved as it is changed and so must not
    // participate in the notification form's dirty tracking or arm the navigation lock.
    private InterfaceLanguage language = InterfaceLanguages.Current;

    // The about card keeps its own state on purpose. It is saved as it is changed, so it must not
    // participate in the notification form's dirty tracking or arm the navigation lock.
    private UpdateStatus updateStatus = UpdateStatus.ForInstalledBuild();
    private bool updateCheckEnabled = true;
    private bool checkingForUpdate;
    private IDisposable? updateSubscription;

    protected override async Task OnInitializedAsync()
    {
        updateStatus = Updates.Current;
        updateSubscription = Updates.Subscribe(() => InvokeAsync(() =>
        {
            updateStatus = Updates.Current;
            StateHasChanged();
        }));

        try
        {
            updateCheckEnabled = await UpdateCheckSettings.IsEnabledAsync();
        }
        catch (Exception)
        {
            // The about card is informational. Failing to read one preference must not stop the
            // notification settings from being shown or saved.
        }

        try
        {
            language = await Languages.GetAsync();
        }
        catch (Exception)
        {
            // Same reasoning. The card falls back to whatever language the process is already running
            // in, which is what the rest of the page is being rendered in anyway.
        }

        await ReloadAsync();
    }

    public void Dispose() => updateSubscription?.Dispose();

    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            view = await NotificationSettings.GetAsync();
            enabled = view.Enabled;
            fromAddress = view.FromAddress ?? "";
            fromName = view.FromName ?? "";
            recipients = string.Join(Environment.NewLine, view.Recipients);
            apiKey = "";
            errors = new Dictionary<string, string>(StringComparer.Ordinal);
            dirty = false;
        }
        catch (Exception)
        {
            SetOutcome(UiStrings.SettingsLoadFailed, true);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            var result = await NotificationSettings.SaveAsync(new SaveNotificationSettingsCommand(
                enabled, fromAddress, fromName, recipients, apiKey));
            errors = result.FieldErrors is null
                ? new Dictionary<string, string>(StringComparer.Ordinal)
                : result.FieldErrors.ToDictionary(
                    entry => entry.Key,
                    entry => MessageText.Resolve(entry.Value),
                    StringComparer.Ordinal);
            SetOutcome(MessageText.Resolve(result.Message), !result.Succeeded);
            if (result.Succeeded)
            {
                dirty = false;
                await ReloadAsync();
            }
        }
        catch (Exception)
        {
            SetOutcome(UiStrings.SettingsSaveFailed, true);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SendTestAsync()
    {
        if (dirty)
        {
            SetOutcome(UiStrings.SettingsSaveBeforeTest, true);
            return;
        }

        await DialogService.ShowAsync<TestEmailDialog>(UiStrings.TestEmailTitle);
    }

    private void EnabledChanged(ChangeEventArgs args)
    {
        enabled = args.Value is true;
        Changed();
    }

    private void Changed()
    {
        dirty = true;
        outcome = null;
    }

    private void SetOutcome(string message, bool error)
    {
        outcome = message;
        outcomeError = error;
    }

    private string SavedText => view.UpdatedAtUtc is { } updated
        ? string.Format(CultureInfo.CurrentCulture, UiStrings.SettingsLastSaved, DisplayFormat.LocalDateTime(updated))
        : UiStrings.SettingsNotSavedYet;

    private RenderFragment ErrorFor(string field) => builder =>
    {
        if (errors.TryGetValue(field, out var message)) builder.AddContent(0, message);
    };

    private async Task UpdateCheckEnabledChanged(ChangeEventArgs args)
    {
        updateCheckEnabled = args.Value is true;
        try
        {
            await UpdateCheckSettings.SetEnabledAsync(updateCheckEnabled);

            // Switching it on asks straight away, because waiting up to a day to learn the answer
            // would make the switch feel broken. Switching it off clears the notice at once.
            await RunUpdateCheckAsync();
        }
        catch (Exception)
        {
            updateCheckEnabled = !updateCheckEnabled;
            SetOutcome(UiStrings.SettingsUpdatePreferenceFailed, true);
        }
    }

    private async Task LanguageChanged(ChangeEventArgs args)
    {
        if (!Enum.TryParse<InterfaceLanguage>(args.Value?.ToString(), out var chosen) || chosen == language)
        {
            return;
        }

        try
        {
            await Languages.SetAsync(chosen);
        }
        catch (Exception)
        {
            SetOutcome(UiStrings.SettingsLanguageFailed, true);
            return;
        }

        language = chosen;

        // Reloaded rather than re-rendered, for the same reason the application bar control reloads:
        // the document language attribute and the reconnect banner are produced outside this circuit.
        Navigation.Refresh(forceReload: true);
    }

    private static string LanguageName(InterfaceLanguage value) => value switch
    {
        InterfaceLanguage.Slovak => UiStrings.LanguageSlovak,
        _ => UiStrings.LanguageEnglish
    };

    private async Task CheckForUpdateAsync() => await RunUpdateCheckAsync();

    private async Task RunUpdateCheckAsync()
    {
        checkingForUpdate = true;
        try
        {
            await UpdateChecks.CheckNowAsync();
        }
        catch (Exception)
        {
            // CheckNowAsync classifies every reachable failure itself and records it on the status,
            // so anything arriving here is unexpected and is already logged by the service.
        }
        finally
        {
            checkingForUpdate = false;
        }
    }

    private string BuildText => ProductVersion.ShortCommitSha is { } sha
        ? string.Format(CultureInfo.CurrentCulture, UiStrings.SettingsBuild, sha)
        : UiStrings.SettingsNoBuildIdentifier;

    private string UpdateCheckText
    {
        get
        {
            if (!updateCheckEnabled)
            {
                return UiStrings.SettingsUpdateCheckOff;
            }

            if (updateStatus.LastProblem is { } problem)
            {
                return string.Format(CultureInfo.CurrentCulture, UiStrings.SettingsUpdateInconclusive, MessageText.Resolve(problem));
            }

            if (updateStatus.LastCheckedUtc is not { } checkedAt)
            {
                return UiStrings.SettingsUpdateNotCheckedYet;
            }

            var when = DisplayFormat.LocalDateTime(checkedAt);
            return updateStatus.LatestDisplay is { } latest
                ? string.Format(CultureInfo.CurrentCulture, UiStrings.SettingsUpdateCheckedLatest, when, latest)
                : string.Format(CultureInfo.CurrentCulture, UiStrings.SettingsUpdateCheckedNone, when);
        }
    }

    private async Task BeforeInternalNavigation(LocationChangingContext context)
    {
        if (!dirty) return;
        context.PreventNavigation();
        if (await DialogService.ShowMessageBoxAsync(
                UiStrings.SettingsLeaveTitle,
                UiStrings.SettingsLeaveBody,
                yesText: UiStrings.SettingsLeaveConfirm,
                cancelText: UiStrings.SettingsLeaveStay) == true)
        {
            dirty = false;
            Navigation.NavigateTo(context.TargetLocation);
        }
    }
}
