@using System.Globalization
@page "/destinations"
@inject DestinationService DestinationService
@inject IDialogService DialogService

<PageTitle>@string.Format(CultureInfo.CurrentCulture, UiStrings.PageTitleFormat, UiStrings.NavDestinations)</PageTitle>

@if (operationMessage is not null)
{
    <MudAlert Severity="@(operationError ? Severity.Error : Severity.Success)" CloseIcon="@Icons.Material.Filled.Close" ShowCloseIcon="true" CloseIconClicked="() => operationMessage = null">@MessageText.Resolve(operationMessage)</MudAlert>
}

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h1">@UiStrings.DestinationsTitle</MudText>
        <MudText Class="page-lead">@UiStrings.DestinationsLead</MudText>
    </div>
    <MudStack Row="true">
        <MudButton Variant="@(showArchived ? Variant.Outlined : Variant.Text)" OnClick="ToggleArchivedAsync">@(showArchived ? UiStrings.DestinationsShowActive : UiStrings.DestinationsShowArchived)</MudButton>
        @if (!showArchived) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">@UiStrings.DestinationsAdd</MudButton> }
    </MudStack>
</div>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (destinations.Count == 0)
{
    <MudPaper Class="destination-empty" Elevation="0">
        <MudIcon Icon="@Icons.Material.Outlined.Storage" Size="Size.Large" />
        <MudText Typo="Typo.h5">@UiStrings.DestinationsEmptyHeading</MudText>
        <MudText>@UiStrings.DestinationsEmptyBody</MudText>
    </MudPaper>
}
else
{
    <div class="destination-grid">
        @foreach (var destination in destinations)
        {
            <MudPaper Class="destination-card" Elevation="0">
                <div class="destination-card-head">
                    <MudIcon Icon="@(destination.Type == DestinationType.Local ? Icons.Material.Outlined.Storage : Icons.Material.Outlined.Dns)" />
                    <div>
                        <MudText Typo="Typo.h5">@destination.Name</MudText>
                        <MudText Typo="Typo.caption">@(destination.Type == DestinationType.Local ? UiStrings.DestinationsLocalStorage : UiStrings.DestinationsSmbStorage)</MudText>
                    </div>
                    <MudChip T="string" Size="Size.Small" Color="@MonitoringDisplay.VerificationColor(destination.VerificationResult)">@MonitoringDisplay.VerificationLabel(destination.VerificationResult)</MudChip>
                </div>
                <MudText Class="destination-path">@destination.RootPath</MudText>
                @if (destination.SmbUsername is not null)
                {
                    <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, UiStrings.DestinationsAccount, destination.SmbUsername)</MudText>
                }
                <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, UiStrings.DestinationsAvailable, DisplayFormat.Bytes(destination.AvailableBytes))</MudText>
                <MudText Typo="Typo.body2">@LastTestText(destination)</MudText>
                <div class="destination-actions">
                    @if (destination.Lifecycle == DestinationLifecycle.Archived)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => RestoreAsync(destination))">@UiStrings.ActionRestore</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditAsync(destination))">@UiStrings.ActionEdit</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.FactCheck" OnClick="@(() => TestAsync(destination))">@UiStrings.DestinationsTestAccess</MudButton>
                        <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="@(() => ArchiveAsync(destination))">@UiStrings.ActionArchive</MudButton>
                    }
                </div>
            </MudPaper>
        }
    </div>
}

@code {
    private IReadOnlyList<DestinationSummary> destinations = [];
    private bool loading = true;
    private bool showArchived;
    private UiMessage? operationMessage;
    private bool operationError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        loading = true;
        var all = await DestinationService.ListAsync(showArchived);
        destinations = showArchived ? all.Where(x => x.Lifecycle == DestinationLifecycle.Archived).ToArray() : all;
        loading = false;
    }
    private async Task ToggleArchivedAsync() { showArchived = !showArchived; await ReloadAsync(); }
    private async Task ArchiveAsync(DestinationSummary destination)
    {
        if (await DialogService.ShowMessageBoxAsync(
                UiStrings.DestinationsArchiveTitle,
                string.Format(CultureInfo.CurrentCulture, UiStrings.DestinationsArchiveBody, destination.Name),
                yesText: UiStrings.ActionArchive,
                cancelText: UiStrings.ActionCancel) != true) return;
        await ApplyAsync(await DestinationService.ArchiveAsync(destination.Id));
    }
    private async Task RestoreAsync(DestinationSummary destination)
    {
        if (await DialogService.ShowMessageBoxAsync(
                UiStrings.DestinationsRestoreTitle,
                string.Format(CultureInfo.CurrentCulture, UiStrings.DestinationsRestoreBody, destination.Name),
                yesText: UiStrings.ActionRestore,
                cancelText: UiStrings.ActionCancel) != true) return;
        await ApplyAsync(await DestinationService.RestoreAsync(destination.Id));
    }
    private async Task ApplyAsync(DestinationOperationResult result)
    {
        operationMessage = result.Message;
        operationError = !result.Succeeded;
        await ReloadAsync();
    }
    private async Task CreateAsync()
    {
        var dialog = await DialogService.ShowAsync<DestinationFormDialog>(UiStrings.DestinationFormAddTitle, options: DialogOptions());
        if ((await dialog.Result)?.Canceled == false) await ReloadAsync();
    }
    private async Task EditAsync(DestinationSummary destination)
    {
        var parameters = new DialogParameters { [nameof(DestinationFormDialog.Destination)] = destination };
        var dialog = await DialogService.ShowAsync<DestinationFormDialog>(UiStrings.DestinationsEditTitle, parameters, DialogOptions());
        if ((await dialog.Result)?.Canceled == false) await ReloadAsync();
    }
    private async Task TestAsync(DestinationSummary destination)
    {
        var parameters = new DialogParameters { [nameof(DestinationTestDialog.Destination)] = destination };
        var dialog = await DialogService.ShowAsync<DestinationTestDialog>(UiStrings.DestinationsTestDialogTitle, parameters, DialogOptions());
        await dialog.Result;
        await ReloadAsync();
    }
    private static DialogOptions DialogOptions() => new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    // The verification chip's colour and label now come from MonitoringDisplay so that a destination
    // reads the same here, on the dashboard, and in the job form.
    private static string LastTestText(DestinationSummary destination) => destination.LastAccessedAtUtc is { } testedAt
        ? string.Format(
            CultureInfo.CurrentCulture,
            UiStrings.DestinationsLastTest,
            MonitoringDisplay.AccessLabel(destination.LastAccessResult),
            DisplayFormat.LocalDateTime(testedAt))
        : UiStrings.DestinationsLastTestNotAttempted;
}
